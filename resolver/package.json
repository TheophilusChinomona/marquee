{
  "name": "marquee-resolver",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted stream resolver for Marquee: turns a title/episode into a playable MP4 or HLS URL.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "probe": "node tools/probe.js",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "playwright-core": "^1.49.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "playwright": "^1.49.1"
  }
}
